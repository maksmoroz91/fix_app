# Значения должны совпадать с /etc/olcrtc/server.yaml на сервере.
# Для jitsi указывайте полный URL комнаты.
JITSI_ROOM_ID=https://meet.handyweb.org/REPLACE_WITH_ROOM_ID

OLCRTC_CARRIER=jitsi

# Генерация: openssl rand -hex 32
# ОДИНАКОВЫЙ на всех устройствах и сервере
OLCRTC_KEY=REPLACE_ME_WITH_64_HEX_CHARS
